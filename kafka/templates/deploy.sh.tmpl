#!/usr/bin/env bash
# Kafka {{NODE_ROLE}}-{{NODE_INDEX}} 节点管理脚本

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE=(docker compose)

info() { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

load_env() {
    [[ -f "$SCRIPT_DIR/.env" ]] || die "缺少 .env"
    # shellcheck disable=SC1091
    set -a; source "$SCRIPT_DIR/.env"; set +a
}

compose() {
    "${COMPOSE[@]}" --project-name "$COMPOSE_PROJECT_NAME" \
        --project-directory "$SCRIPT_DIR" --env-file "$SCRIPT_DIR/.env" \
        -f "$SCRIPT_DIR/docker-compose.yml" "$@"
}

check_files() {
    local file
    for file in .env docker-compose.yml manifest.json checksums.sha256 config/server.properties config/log4j2.yaml; do
        [[ -f "$SCRIPT_DIR/$file" ]] || die "缺少节点包文件: $file"
    done
    if [[ "${ENABLE_AUTH:-false}" == true && "$NODE_ROLE" == controller ]]; then
        [[ -f "$SCRIPT_DIR/config/bootstrap.scram" ]] || die "缺少初始 SCRAM 凭据"
    fi
    (cd "$SCRIPT_DIR" && sha256sum -c checksums.sha256 >/dev/null) || die "节点包文件摘要不匹配"
}

check_runtime() {
    [[ $EUID -eq 0 ]] || die "部署目录位于 /root，必须使用 root 执行"
    command -v docker >/dev/null 2>&1 || die "未安装 Docker；请先运行 docker/setup-docker.sh"
    docker info >/dev/null 2>&1 || die "Docker daemon 不可用"
    docker compose version >/dev/null 2>&1 || die "需要 Docker Compose V2"
    compose config --quiet
}

check_host() {
    [[ "$DEPLOY_DIR" == /root/deploy/kafka/* ]] || die "DEPLOY_DIR 不符合规划: $DEPLOY_DIR"
    local data_base="$KAFKA_DATA_BASE_DIR"
    [[ "$HOST_DATA_DIR" == "$data_base/"* ]] || die "HOST_DATA_DIR 不在配置的 KAFKA_DATA_BASE_DIR 内: $HOST_DATA_DIR"
    [[ "$(pwd -P)" == "$DEPLOY_DIR" || "$SCRIPT_DIR" == "$DEPLOY_DIR" ]] || warn "节点包当前位于 ${SCRIPT_DIR}，部署路径应为 $DEPLOY_DIR"
    # The base/role directory may not exist before first prepare. Inspect its nearest
    # existing ancestor without creating directories on an accidentally unmounted disk.
    local storage_probe="$HOST_DATA_DIR" data_mount
    while [[ ! -e "$storage_probe" ]]; do
        [[ ! -L "$storage_probe" ]] || die "数据路径包含失效的符号链接: $storage_probe"
        storage_probe="$(dirname "$storage_probe")"
    done
    [[ -d "$storage_probe" ]] || die "数据路径的已有父路径不是目录: $storage_probe"
    command -v findmnt >/dev/null 2>&1 || die "需要 util-linux findmnt 来识别数据文件系统"
    data_mount="$(findmnt -rn -o TARGET -T "$storage_probe")" || die "无法识别数据目录所在文件系统: $storage_probe"
    [[ -n "$data_mount" ]] || die "无法识别数据目录所在文件系统: $storage_probe"
    info "Kafka 数据基础目录: ${data_base}；所在挂载点: $data_mount"
    if [[ "${DEPLOY_PROFILE:-}" == manual ]]; then
        warn "manual 规格：允许 $data_mount 使用系统盘目录"
        local available_gb
        available_gb="$(df -BG --output=avail "$storage_probe" | tail -1 | tr -dc '0-9')"
        (( available_gb >= 5 )) || die "$data_mount 可用空间不足 5GB"
        return
    fi
    [[ "$data_mount" != / ]] || die "生产数据目录位于系统根文件系统，请先挂载独立数据盘: $data_base"
    local used_pct
    used_pct="$(df -P "$storage_probe" | awk 'NR==2 {gsub(/%/,"",$5); print $5}')"
    (( used_pct < 85 )) || die "$data_mount 使用率 ${used_pct}% 已达到阻断阈值"
    (( used_pct < 70 )) || warn "$data_mount 使用率 ${used_pct}% 已超过规划线"
}

check_identity() {
    local meta="$HOST_DATA_DIR/meta.properties" actual
    [[ -f "$meta" ]] || return 0
    actual="$(awk -F= '$1=="cluster.id" {print $2}' "$meta")"
    [[ "$actual" == "$CLUSTER_ID" ]] || die "数据目录 cluster.id 不匹配"
    actual="$(awk -F= '$1=="node.id" {print $2}' "$meta")"
    [[ "$actual" == "$NODE_ID" ]] || die "数据目录 node.id 不匹配"
    if [[ "$NODE_ROLE" == controller ]]; then
        actual="$(awk -F= '$1=="directory.id" {print $2}' "$meta")"
        [[ -z "$actual" || "$actual" == "$DIRECTORY_ID" ]] || die "controller directory.id 不匹配"
    fi
}

check() {
    load_env
    check_files
    check_runtime
    check_host
    check_identity
    info "$NODE_ROLE-$NODE_INDEX 节点检查通过"
}

prepare() {
    check
    mkdir -p "$HOST_DATA_DIR"
    # Resolve the configured image user instead of assuming the container runs as root.
    local image_owner
    image_owner="$(docker run --rm --network none --memory 64m --memory-swap 64m --entrypoint /bin/sh "$KAFKA_IMAGE" \
        -ec 'printf "%s:%s\n" "$(id -u)" "$(id -g)"')"
    [[ "$image_owner" =~ ^[0-9]+:[0-9]+$ ]] || die "无法确定 Kafka 镜像运行 UID/GID: $image_owner"
    chown "$image_owner" "$HOST_DATA_DIR" "$SCRIPT_DIR/config" \
        "$SCRIPT_DIR/config/server.properties" "$SCRIPT_DIR/config/log4j2.yaml"
    chmod 750 "$HOST_DATA_DIR" "$SCRIPT_DIR/config"
    if [[ -f "$HOST_DATA_DIR/meta.properties" ]]; then
        info "数据目录已经格式化，身份一致，跳过"
        if [[ "${ENABLE_AUTH:-false}" == true && "$NODE_ROLE" == controller ]]; then
            warn "已有数据目录不会写入或更新初始账号；账号变更使用 kafka-configs.sh"
        fi
        return
    fi
    if find "$HOST_DATA_DIR" -mindepth 1 -print -quit | grep -q .; then
        die "数据目录非空但不存在 meta.properties，拒绝格式化: $HOST_DATA_DIR"
    fi

    local -a format_args=(format --cluster-id "$CLUSTER_ID" --config /etc/kafka/custom/server.properties)
    if [[ "$NODE_ROLE" == controller ]]; then
        format_args+=(--initial-controllers "$INITIAL_CONTROLLERS")
        if [[ "${ENABLE_AUTH:-false}" == true ]]; then
            format_args+=(--add-scram "$(cat "$SCRIPT_DIR/config/bootstrap.scram")")
        fi
    else
        format_args+=(--no-initial-controllers)
    fi
    info "格式化 $NODE_ROLE-$NODE_INDEX 数据目录"
    docker run --rm --network host \
        --memory 512m --memory-swap 512m \
        -e KAFKA_HEAP_OPTS='-Xms128m -Xmx256m' \
        -v "$SCRIPT_DIR/config:/etc/kafka/custom:ro" \
        -v "$HOST_DATA_DIR:/var/lib/kafka/data" \
        --entrypoint /opt/kafka/bin/kafka-storage.sh \
        "$KAFKA_IMAGE" "${format_args[@]}"
    [[ -f "$HOST_DATA_DIR/meta.properties" ]] || die "格式化完成后缺少 meta.properties"
    check_identity
    info "prepare 完成"
}

start() {
    check
    [[ -f "$HOST_DATA_DIR/meta.properties" ]] || die "尚未 prepare"
    compose up -d
    compose ps
}
stop() { load_env; check_files; check_runtime; compose down; }
restart() { load_env; check_files; check_runtime; check_identity; compose restart; compose ps; }
status() { load_env; check_files; check_runtime; compose ps; }
logs() { load_env; check_files; check_runtime; compose logs -f --tail="${2:-200}"; }

controller_quorum_cli() {
    local endpoint="$1" query="$2"
    # Use a temporary CLI container so its JVM does not consume the controller's
    # memory limit. Controller traffic is PLAINTEXT; no client password is needed.
    docker run --rm --network host \
        --memory 512m --memory-swap 512m \
        -e KAFKA_HEAP_OPTS='-Xms128m -Xmx256m' \
        -e KAFKA_LOG4J_OPTS='-Dlog4j2.configurationFile=/opt/kafka/config/tools-log4j2.yaml' \
        --entrypoint /bin/bash "$KAFKA_IMAGE" -ec '
            config=$(mktemp)
            trap '\''rm -f "$config"'\'' EXIT
            printf "%s\n" default.api.timeout.ms=5000 request.timeout.ms=3000 \
                socket.connection.setup.timeout.ms=1000 \
                socket.connection.setup.timeout.max.ms=3000 > "$config"
            /opt/kafka/bin/kafka-metadata-quorum.sh --bootstrap-controller "$1" \
                --command-config "$config" describe "$2"
        ' _ "$endpoint" "$query"
}

controller_status_leader() {
    awk -v cluster="$CLUSTER_ID" -v expected="$1" '
        BEGIN { count=split(expected, ids, ","); for(i=1;i<=count;i++) want[ids[i]]=1 }
        /^ClusterId:/ { cluster_ok=($2==cluster) }
        /^LeaderId:/ { leader=$2 }
        /^HighWatermark:/ { watermark_ok=($2 ~ /^[0-9]+$/) }
        /^CurrentVoters:/ {
            line=$0; sub(/^[^:]*:/,"",line)
            if (line ~ /"id"[[:space:]]*:/) {
                while (match(line,/"id"[[:space:]]*:[[:space:]]*[0-9]+/)) {
                    id=substr(line,RSTART,RLENGTH); sub(/.*:/,"",id); gsub(/[[:space:]]/,"",id)
                    seen[id]++; total++; line=substr(line,RSTART+RLENGTH)
                }
            }
        }
        END {
            valid=(cluster_ok && watermark_ok && (leader in want) && total==count)
            for(id in want) if(seen[id]!=1) valid=0
            if(!valid) { print "cluster ID、leader、watermark 或 voter 清单不符合预期"; exit 1 }
            print leader
        }
    '
}

controller_replication_ready() {
    awk -v expected="$1" -v leader="$2" '
        BEGIN { count=split(expected, ids, ","); for(i=1;i<=count;i++) want[ids[i]]=1 }
        $1=="NodeId" {
            for(i=1;i<=NF;i++) column[$i]=i
            header=(column["NodeId"] && column["Lag"] && column["Status"]); next
        }
        header && $1 ~ /^[0-9]+$/ {
            id=$(column["NodeId"]); state=tolower($(column["Status"]))
            if(id in want) {
                seen[id]++
                if($(column["Lag"])!="0") bad=1
                if(id==leader) { if(state!="leader") bad=1 }
                else if(state!="follower") bad=1
            } else if(state=="leader" || state=="follower") bad=1
        }
        END {
            if(!header) bad=1
            for(id in want) if(seen[id]!=1) bad=1
            if(bad) { print "controller 复制成员、角色或 lag 不符合预期（要求全部 lag=0）"; exit 1 }
        }
    '
}

controller_health_probe() {
    local ids="$1" endpoints="$2" endpoint output leader reference_leader=""
    HEALTH_STATUS=""; HEALTH_REPLICATION=""; HEALTH_DETAILS=""
    local -a hosts
    IFS=',' read -r -a hosts <<< "$endpoints"
    for endpoint in "${hosts[@]}"; do
        if ! output="$(controller_quorum_cli "$endpoint" --status 2>&1)"; then
            HEALTH_ERROR="controller 入口 $endpoint 查询失败"; HEALTH_DETAILS="$output"; return 1
        fi
        if ! leader="$(printf '%s\n' "$output" | controller_status_leader "$ids")"; then
            HEALTH_ERROR="$endpoint: $leader"; HEALTH_DETAILS="$output"; return 1
        fi
        if [[ -n "$reference_leader" && "$leader" != "$reference_leader" ]]; then
            HEALTH_ERROR="各 controller 入口返回的 leader 不一致，可能正在选举"; return 1
        fi
        reference_leader="$leader"
        [[ -n "$HEALTH_STATUS" ]] || HEALTH_STATUS="$output"
    done
    if ! output="$(controller_quorum_cli "${hosts[0]}" --replication 2>&1)"; then
        HEALTH_ERROR="controller 复制状态查询失败"; HEALTH_DETAILS="$output"; return 1
    fi
    HEALTH_REPLICATION="$output"
    if ! HEALTH_ERROR="$(printf '%s\n' "$output" | controller_replication_ready "$ids" "$reference_leader")"; then
        HEALTH_DETAILS="$output"; return 1
    fi
}

health() {
    load_env
    [[ "$NODE_ROLE" == controller ]] || die "health 仅适用于 controller 包"
    [[ $# -le 2 ]] || die "用法: $0 health [等待秒数，0-86400]"
    local wait_seconds="${2:-0}"
    [[ "$wait_seconds" =~ ^[0-9]+$ && ${#wait_seconds} -le 5 ]] || die "用法: $0 health [等待秒数，0-86400]"
    wait_seconds=$((10#$wait_seconds))
    (( wait_seconds <= 86400 )) || die "等待时间不能超过 86400 秒"
    check_files
    check_runtime
    local entry ids="" endpoints="" id endpoint deadline
    local -a entries
    IFS=',' read -r -a entries <<< "$INITIAL_CONTROLLERS"
    for entry in "${entries[@]}"; do
        [[ "$entry" =~ ^([0-9]+)@([^:]+:[0-9]+):([A-Za-z0-9_-]+)$ ]] || die "INITIAL_CONTROLLERS 格式无效"
        id="${BASH_REMATCH[1]}"; endpoint="${BASH_REMATCH[2]}"
        [[ ",$ids," != *",$id,"* ]] || die "INITIAL_CONTROLLERS 中的节点 ID 重复"
        ids+="${ids:+,}$id"; endpoints+="${endpoints:+,}$endpoint"
    done
    [[ ${#entries[@]} -eq 3 ]] || die "当前集群应包含 3 个 controller"
    deadline=$((SECONDS + wait_seconds))
    while true; do
        if controller_health_probe "$ids" "$endpoints"; then
            printf '%s\n\n%s\n' "$HEALTH_STATUS" "$HEALTH_REPLICATION"
            info "controller 集群健康：3 个入口可访问，集群身份一致，有合法 leader，全部 voter 复制 lag=0"
            return 0
        fi
        if (( SECONDS >= deadline )); then
            [[ -z "$HEALTH_DETAILS" ]] || printf '%s\n' "$HEALTH_DETAILS" >&2
            die "controller 集群未就绪: $HEALTH_ERROR"
        fi
        warn "${HEALTH_ERROR}；2 秒后重试"
        sleep 2
    done
}

usage() {
    echo "用法: $0 {check|prepare|start|stop|restart|status|logs [tail]|health [等待秒数]}"
    echo "health：仅 controller；默认检查一次，可指定轮询等待时间"
}

case "${1:-}" in
    check) check ;;
    prepare) prepare ;;
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status) status ;;
    logs) logs "$@" ;;
    health) health "$@" ;;
    *) usage; [[ -z "${1:-}" ]] || exit 1 ;;
esac
