# Kafka 集群初始化配置。cluster init 首次运行时自动创建 kafka-admin.conf 并交互采集配置。
CLUSTER_NAME="hr-kafka"
KAFKA_IMAGE="apache/kafka:4.3.2"
# standard / minimal 为生产规格；manual 按角色指定容器资源。
DEPLOY_PROFILE="standard"
# 仅 manual 必填。CPU 以核为单位，内存使用整数 MiB（如 768m）或 GiB（如 2g）。
MANUAL_CONTROLLER_CPU=""
MANUAL_CONTROLLER_MEMORY=""
MANUAL_BROKER_CPU=""
MANUAL_BROKER_MEMORY=""

# 3 个 controller 与 3 个 broker，按序号一一共置时可填写相同地址。
CONTROLLER_HOSTS=""
BROKER_HOSTS=""

CONTROLLER_PORT="9093"
BROKER_PORT="9092"
ENABLE_EXTERNAL_LISTENER="false"
EXTERNAL_PORT="19092"
# 开启认证时自动启用 EXTERNAL 客户端入口；内部通信始终免认证，不启用 TLS/ACL。
ENABLE_AUTH="false"
AUTH_USERNAME="admin"
# 首次 cluster init 时留空自动生成 6 位随机密码并保存；已有配置则沿用，不自动轮换。
# 手动指定不限制长度，使用 ASCII 字母、数字或 _@%+=:./-。不要提交真实密码。
AUTH_PASSWORD=""

TARGET_DEPLOY_ROOT="/root/deploy/kafka"
# 各角色数据目录的公共基础目录；脚本自动识别所在文件系统，无需配置挂载点。
KAFKA_DATA_BASE_DIR="/data1/kafka"
# 规格仅约束 CPU、内存和 heap；磁盘容量按实际业务规划，不设置固定容量门槛。
# manual 允许系统盘目录；生产规格仍要求数据位于独立挂载的文件系统。

LOG_RETENTION_HOURS="168"
LOG_SEGMENT_BYTES="1073741824"
LOG_ROLL_HOURS="24"
LOG_RETENTION_CHECK_INTERVAL_MS="300000"
DELETE_TOPIC_ENABLE="true"

LOG_MAX_SIZE="50m"
LOG_MAX_FILE="5"
NOFILE_LIMIT="100000"
